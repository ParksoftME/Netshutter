    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "KGNF Games"
      VALUE "FileDescription", "NetShutter"
      VALUE "FileVersion", "1.0.5.0"
      VALUE "ProductName", "NetShutter"
      VALUE "ProductVersion", "1.0.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
